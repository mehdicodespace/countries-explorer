# Create a free API key at https://restcountries.com/sign-up.
# The key is used by the local Vite proxy and the Netlify Function, never by browser code.
REST_COUNTRIES_API_KEY=replace-with-your-api-key

# Optional API path. VITE_ variables are shipped to the browser and must not contain secrets.
VITE_API_BASE_URL=/api/countries/v5
